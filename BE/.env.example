# Salin ke .env lalu isi. File .env tidak pernah di-commit.

# --- Aplikasi ---
SECRET_KEY=ganti-dengan-string-acak-panjang
DEMO_PASSWORD=ganti-password-demo
# Database: Supabase PostgreSQL (rekomendasi pooler port 6543 atau direct 5432)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
TIMEZONE=Asia/Jakarta
SESSION_TTL_MINUTES=480
SECURE_COOKIES=false
CORS_ORIGINS=
# Hanya untuk demo lokal dengan SATUSEHAT_MODE=mock.
ENABLE_DEMO_SEED=true

# --- SATUSEHAT (sandbox) ---
# mock = tanpa internet (untuk uji); sandbox = API Kemenkes staging
SATUSEHAT_MODE=mock
SATUSEHAT_AUTH_URL=
SATUSEHAT_BASE_URL=
SATUSEHAT_CLIENT_ID=
SATUSEHAT_CLIENT_SECRET=
SATUSEHAT_ORG_ID=

# --- ASR ---
# "small" = model bawaan faster-whisper; ganti dengan path folder CT2 hasil fine-tune
ASR_MODEL=small
# Model akhir: transkripsi ulang seluruh audio setelah rekaman selesai (lebih akurat, lebih lambat).
# Kosongkan untuk memakai ASR_MODEL saja.
ASR_FINAL_MODEL=large-v3-turbo
# Prompt awal Whisper: dewasa (poli umum/penyakit dalam) | anak | none
ASR_PROMPT=dewasa
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_PREPROCESS=true
ASR_HIGHPASS_HZ=80

# --- LLM ("mock" = tanpa API, untuk uji) ---
# Aktif hanya Claude dengan urutan fallback model: Sonnet -> Haiku.
# Gagal Claude tidak mengaktifkan Gemini atau mock.
LLM_PROVIDERS=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MODELS=claude-sonnet-5-5,claude-haiku-5-5
CLAUDE_MAX_TOKENS=4096
CLAUDE_PROMPT_CACHE=true
CLAUDE_THINKING_DISABLED=false
CLAUDE_EFFORT=
# Batas per request 45s, total deadline fallback 75s, max 1 retry/model.
# Circuit breaker: buka 60s setelah 2 gagal ketersediaan beruntun (1 probe half-open).
LLM_TIMEOUT_S=45
LLM_TOTAL_TIMEOUT_S=75
LLM_MAX_RETRIES=1
LLM_CB_FAILURE_THRESHOLD=2
LLM_CB_COOLDOWN_S=60
LLM_RETRY_AFTER_MAX_S=5

# Gemini tersedia tetapi tidak aktif pada konfigurasi di atas.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.5-flash

# Disiapkan untuk adapter OpenAI milik Kemal (belum diimplementasikan di A1-A5).
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# Server kompatibel lain perlu pengujian terpisah; jangan isi key Claude di sini.
