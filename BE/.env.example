# Salin ke .env lalu isi. File .env tidak pernah di-commit.

# --- Aplikasi ---
SECRET_KEY=ganti-dengan-string-acak-panjang
DEMO_PASSWORD=ganti-password-demo
# Database: Supabase PostgreSQL (rekomendasi pooler port 6543 atau direct 5432)
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./comehear.db
TIMEZONE=Asia/Jakarta

# --- SATUSEHAT (sandbox) ---
# mock = tanpa internet (untuk uji); sandbox = API Kemenkes staging
SATUSEHAT_MODE=mock
SATUSEHAT_AUTH_URL=https://api-satusehat-stg.dto.kemkes.go.id/oauth2/v1
SATUSEHAT_BASE_URL=https://api-satusehat-stg.dto.kemkes.go.id/fhir-r4/v1
SATUSEHAT_CLIENT_ID=
SATUSEHAT_CLIENT_SECRET=
SATUSEHAT_ORG_ID=647ba346-c21f-4328-86f2-c6ce268cde97

# --- ASR ---
# "small" = model bawaan faster-whisper; ganti dengan path folder CT2 hasil fine-tune
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8

# --- LLM (urutan dicoba dari kiri; "mock" = tanpa API, untuk uji) ---
LLM_PROVIDERS=gemini,anthropic
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
